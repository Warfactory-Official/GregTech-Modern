+package com.gregtechceu.gtceu.threadingbench;
+
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Supplier;
+
+/**
+ * MC-free harness for the per-block-change multiblock chunk lookup. Run: {@code java MultiblockIndexBench.java}.
+ */
+public final class MultiblockIndexBench {
+
+    record Cp(int x, int z) {
+
+        @Override
+        public int hashCode() {
+            return (1664525 * x + 1013904223) ^ (1664525 * (z ^ -559038737) + 1013904223);
+        }
+    }
+
+    static final class Pattern {
+
+        final Map<Long, Object> cache = new HashMap<>();
+    }
+
+    record Factory(Supplier<Object> a, Supplier<Object> b) {}
+
+    static final Object STORAGE_VALUE = new Object();
+    static final Map<String, Object> dataStorage = new HashMap<>();
+    static final Pattern[] NONE = new Pattern[0];
+    static volatile long sink;
+
+    // vanilla-original: HashMap + toArray + Set.of per call, storage lookup per call
+    static final Map<Cp, Set<Pattern>> origIdx = new HashMap<>();
+    // patched-before: CHM + keyset
+    static final Map<Cp, Set<Pattern>> curIdx = new ConcurrentHashMap<>();
+    // new: CHM<Cp, array>, cached storage
+    static final Map<Cp, Pattern[]> newIdx = new ConcurrentHashMap<>();
+    static Object cachedStorage;
+
+    static Object getOrCreate() {
+        Factory f = new Factory(() -> STORAGE_VALUE, () -> STORAGE_VALUE);
+        Object o = dataStorage.get("gtceu_multiblock");
+        return o != null ? o : f.a().get();
+    }
+
+    static long orig(Cp c, long pos) {
+        getOrCreate();
+        Set<Pattern> copy = Set.of(origIdx.getOrDefault(c, Collections.emptySet()).toArray(Pattern[]::new));
+        long hits = 0;
+        for (Pattern p : copy) if (p.cache.containsKey(pos)) hits++;
+        return hits;
+    }
+
+    static long cur(Cp c, long pos) {
+        getOrCreate();
+        long hits = 0;
+        for (Pattern p : curIdx.getOrDefault(c, Collections.emptySet()).toArray(Pattern[]::new))
+            if (p.cache.containsKey(pos)) hits++;
+        return hits;
+    }
+
+    static long neu(Cp c, long pos) {
+        Object s = cachedStorage;
+        if (s == null) cachedStorage = s = getOrCreate();
+        Pattern[] ps = newIdx.get(c);
+        if (ps == null) return 0;
+        long hits = 0;
+        for (Pattern p : ps) if (p.cache.containsKey(pos)) hits++;
+        return hits;
+    }
+
+    interface Fn {
+
+        long run(Cp c, long pos);
+    }
+
+    static double time(Fn f, Cp[] cps, int iters) {
+        long t0 = System.nanoTime();
+        long acc = 0;
+        for (int i = 0; i < iters; i++) acc += f.run(cps[i & 1023], i);
+        long t = System.nanoTime() - t0;
+        sink = acc;
+        return (double) t / iters;
+    }
+
+    public static void main(String[] a) {
+        dataStorage.put("gtceu_multiblock", STORAGE_VALUE);
+        Random r = new Random(3);
+        Cp[] empty = new Cp[1024];
+        Cp[] busy = new Cp[1024];
+        for (int i = 0; i < 1024; i++) {
+            empty[i] = new Cp(i, 5000);
+            busy[i] = new Cp(i, 0);
+        }
+        // 1024 chunks, each with 2 patterns of 30 cached positions
+        for (Cp c : busy) {
+            Set<Pattern> o = new HashSet<>(), k = ConcurrentHashMap.newKeySet();
+            Pattern[] arr = new Pattern[2];
+            for (int i = 0; i < 2; i++) {
+                Pattern p = new Pattern();
+                for (int j = 0; j < 30; j++) p.cache.put(r.nextLong(), STORAGE_VALUE);
+                o.add(p);
+                k.add(p);
+                arr[i] = p;
+            }
+            origIdx.put(c, o);
+            curIdx.put(c, k);
+            newIdx.put(c, arr);
+        }
+        // dirty world: 1 chunk with patterns among 1024 empty-chunk probes uses empty[]; map holds 1024 entries
+        Fn[] fs = { MultiblockIndexBench::orig, MultiblockIndexBench::cur, MultiblockIndexBench::neu };
+        String[] names = { "original (HashMap+Set.of+storage lookup)", "patched-before (CHM keyset toArray)",
+                "new (CHM array, cached storage)" };
+        for (int w = 0; w < 6; w++) for (Fn f : fs) {
+            time(f, empty, 2_000_000);
+            time(f, busy, 2_000_000);
+        }
+        System.out.println("== V14 per block change ns/op (no-pattern chunk | chunk with 2 patterns, pos not in cache)");
+        for (int k = 0; k < fs.length; k++) {
+            double e = 1e9, b = 1e9;
+            for (int rep = 0; rep < 9; rep++) {
+                e = Math.min(e, time(fs[k], empty, 20_000_000));
+                b = Math.min(b, time(fs[k], busy, 20_000_000));
+            }
+            System.out.printf("  %-42s %.2f | %.2f%n", names[k], e, b);
+        }
+    }
+}
