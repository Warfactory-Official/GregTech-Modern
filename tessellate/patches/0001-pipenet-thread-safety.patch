+package com.gregtechceu.gtceu.api.pipenet;
+
+import net.minecraft.core.BlockPos;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Per-net route cache. {@link #map()} once per lookup and put into that snapshot: a put racing {@link #clear()}
+ * lands in the discarded map, never re-caching stale routes.
+ */
+public final class RouteCache<V> {
+
+    private volatile Map<BlockPos, V> map = new ConcurrentHashMap<>();
+
+    public Map<BlockPos, V> map() {
+        return map;
+    }
+
+    public void clear() {
+        map = new ConcurrentHashMap<>();
+    }
+}
