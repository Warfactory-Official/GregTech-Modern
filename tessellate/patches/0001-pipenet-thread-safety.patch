+package com.gregtechceu.gtceu.threadingbench;
+
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * MC-free harness: key classes copy BlockPos/ChunkPos hash+equals. Run: {@code java PipeNetBench.java}.
+ */
+public final class PipeNetBench {
+
+    record Cp(int x, int z) {
+
+        @Override
+        public int hashCode() {
+            return (1664525 * x + 1013904223) ^ (1664525 * (z ^ -559038737) + 1013904223);
+        }
+    }
+
+    static final class Bp {
+
+        final int x, y, z;
+
+        Bp(int x, int y, int z) {
+            this.x = x;
+            this.y = y;
+            this.z = z;
+        }
+
+        @Override
+        public int hashCode() {
+            return (y + z * 31) * 31 + x;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof Bp b && b.x == x && b.y == y && b.z == z;
+        }
+    }
+
+    static final class Node {}
+
+    interface Net {
+
+        boolean contains(Bp p);
+    }
+
+    static final class MapNet implements Net {
+
+        final Map<Bp, Node> nodes;
+
+        MapNet(Map<Bp, Node> m) {
+            nodes = m;
+        }
+
+        public boolean contains(Bp p) {
+            return nodes.containsKey(p);
+        }
+    }
+
+    static volatile Object sink;
+
+    // ---------- V10 ----------
+    interface Lookup {
+
+        Net get(Bp p);
+    }
+
+    static Lookup oldLookup(Map<Cp, List<Net>> byChunk) {
+        return p -> {
+            for (Net n : byChunk.getOrDefault(new Cp(p.x >> 4, p.z >> 4), Collections.emptyList()))
+                if (n.contains(p)) return n;
+            return null;
+        };
+    }
+
+    static Lookup currentLookup(Map<Cp, List<Net>> byChunk) {
+        return p -> {
+            List<Net> l = byChunk.get(new Cp(p.x >> 4, p.z >> 4));
+            if (l == null) return null;
+            for (Net n : l) if (n.contains(p)) return n;
+            return null;
+        };
+    }
+
+    static Lookup indexedLookup(Map<Cp, List<Net>> byChunk) {
+        return p -> {
+            List<Net> l = byChunk.get(new Cp(p.x >> 4, p.z >> 4));
+            if (l == null) return null;
+            for (int i = 0, n = l.size(); i < n; i++) {
+                Net net = l.get(i);
+                if (net.contains(p)) return net;
+            }
+            return null;
+        };
+    }
+
+    static Lookup arrayLookup(Map<Cp, Net[]> byChunk) {
+        return p -> {
+            Net[] a = byChunk.get(new Cp(p.x >> 4, p.z >> 4));
+            if (a == null) return null;
+            for (Net n : a) if (n.contains(p)) return n;
+            return null;
+        };
+    }
+
+    static double timeLookup(Lookup l, Bp[] probes, int iters) {
+        long t0 = System.nanoTime();
+        Object acc = null;
+        for (int i = 0; i < iters; i++) {
+            Net n = l.get(probes[i & (probes.length - 1)]);
+            if (n != null) acc = n;
+        }
+        long t = System.nanoTime() - t0;
+        sink = acc;
+        return (double) t / iters;
+    }
+
+    static void v10() {
+        System.out.println("== V10 getNetFromPos ns/op (hit 1 net/chunk, hit 2nd of 2 nets, miss chunk); 1024 chunks");
+        for (int nets : new int[] { 1, 2 }) {
+            Map<Cp, List<Net>> oldM = new HashMap<>();
+            Map<Cp, List<Net>> curM = new ConcurrentHashMap<>();
+            Map<Cp, Net[]> arrM = new ConcurrentHashMap<>();
+            Map<Cp, List<Net>> arrL = new ConcurrentHashMap<>();
+            Map<Cp, List<Net>> oldMapNodes = new HashMap<>();
+            Random r = new Random(1);
+            Bp[] hit = new Bp[4096];
+            Bp[] miss = new Bp[4096];
+            int h = 0;
+            for (int cx = 0; cx < 32; cx++) {
+                for (int cz = 0; cz < 32; cz++) {
+                    List<Net> oldL = new ArrayList<>();
+                    List<Net> curL = new ArrayList<>();
+                    Net[] arr = new Net[nets];
+                    Bp target = null;
+                    for (int k = 0; k < nets; k++) {
+                        Map<Bp, Node> hm = new HashMap<>();
+                        Map<Bp, Node> cm = new ConcurrentHashMap<>();
+                        for (int i = 0; i < 20; i++) {
+                            Bp b = new Bp(cx * 16 + r.nextInt(16), 64 + k * 100, cz * 16 + r.nextInt(16));
+                            hm.put(b, new Node());
+                            cm.put(b, new Node());
+                            target = b;
+                        }
+                        oldL.add(new MapNet(hm));
+                        curL.add(new MapNet(cm));
+                        arr[k] = curL.get(k);
+                    }
+                    Cp c = new Cp(cx, cz);
+                    oldM.put(c, oldL);
+                    curM.put(c, Collections.unmodifiableList(curL));
+                    arrM.put(c, arr);
+                    arrL.put(c, curL);
+                    if (h < 4096) {
+                        hit[h] = target;
+                        miss[h] = new Bp(cx * 16 + 5000 * 16, 64, cz * 16);
+                        h++;
+                    }
+                }
+            }
+            for (int i = h; i < 4096; i++) {
+                hit[i] = hit[i - h];
+                miss[i] = miss[i - h];
+            }
+            Lookup[] ls = { oldLookup(oldM), currentLookup(curM), indexedLookup(curM), indexedLookup(arrL), arrayLookup(arrM) };
+            String[] names = { "old HashMap+List", "cur CHM+unmodList", "CHM+unmodList idx", "CHM+ArrayList idx", "CHM+array" };
+            for (int w = 0; w < 5; w++) for (Lookup l : ls) {
+                timeLookup(l, hit, 2_000_000);
+                timeLookup(l, miss, 2_000_000);
+            }
+            for (int k = 0; k < ls.length; k++) {
+                double a = 1e9, b = 1e9;
+                for (int rep = 0; rep < 7; rep++) {
+                    a = Math.min(a, timeLookup(ls[k], hit, 20_000_000));
+                    b = Math.min(b, timeLookup(ls[k], miss, 20_000_000));
+                }
+                System.out.printf("  nets/chunk=%d %-19s hit(last) %.2f  miss %.2f%n", nets, names[k], a, b);
+            }
+        }
+    }
+
+    // ---------- V11 ----------
+    static long used() {
+        for (int i = 0; i < 5; i++) {
+            System.gc();
+            try {
+                Thread.sleep(50);
+            } catch (InterruptedException e) {}
+        }
+        Runtime rt = Runtime.getRuntime();
+        return rt.totalMemory() - rt.freeMemory();
+    }
+
+    static void v11() {
+        System.out.println("== V11 nodeByBlockPos: put/get ns, bytes/entry excl. key+value objects");
+        Node shared = new Node();
+        for (int n : new int[] { 1_000, 10_000, 100_000 }) {
+            Bp[] keys = new Bp[n];
+            Random r = new Random(2);
+            for (int i = 0; i < n; i++) keys[i] = new Bp(r.nextInt(2000) - 1000, r.nextInt(64), r.nextInt(2000) - 1000);
+            for (String kind : new String[] { "HashMap", "CHM", "CHM(presized)" }) {
+                double put = 1e18, get = 1e18;
+                for (int rep = 0; rep < 15; rep++) {
+                    long t0 = System.nanoTime();
+                    Map<Bp, Node> m = make(kind, n);
+                    for (Bp k : keys) m.put(k, shared);
+                    put = Math.min(put, (double) (System.nanoTime() - t0) / n);
+                    int c = 0;
+                    t0 = System.nanoTime();
+                    for (int pass = 0; pass < 20; pass++) for (Bp k : keys) if (m.get(k) != null) c++;
+                    get = Math.min(get, (double) (System.nanoTime() - t0) / (20.0 * n));
+                    sink = c;
+                }
+                long before = used();
+                Map<Bp, Node> m = make(kind, n);
+                for (Bp k : keys) m.put(k, shared);
+                long after = used();
+                sink = m;
+                System.out.printf("  n=%-7d %-14s put %.1f ns  get %.2f ns  %.1f B/entry%n", n, kind, put, get,
+                        (double) (after - before) / n);
+            }
+        }
+    }
+
+    static Map<Bp, Node> make(String kind, int n) {
+        return switch (kind) {
+            case "HashMap" -> new HashMap<>();
+            case "CHM" -> new ConcurrentHashMap<>();
+            default -> new ConcurrentHashMap<>(n * 2);
+        };
+    }
+
+    // ---------- V12/V13/V15 ----------
+    static final class Cache {
+
+        private volatile Map<Bp, Object> map = new ConcurrentHashMap<>();
+
+        Map<Bp, Object> map() {
+            return map;
+        }
+    }
+
+    static final class Holder {
+
+        volatile boolean hasWaiting;
+        boolean plain;
+        final ArrayList<Object> waiting = new ArrayList<>();
+        final Queue<Runnable> inbox = new java.util.concurrent.ConcurrentLinkedQueue<>();
+    }
+
+    static void v12to15() {
+        System.out.println("== V12 route lookup, V13 hasWaiting, V15 inbox poll (ns/op)");
+        Cache c = new Cache();
+        Bp k = new Bp(1, 2, 3);
+        c.map.put(k, "x");
+        Map<Bp, Object> plain = new HashMap<>();
+        plain.put(k, "x");
+        Holder h = new Holder();
+        int N = 200_000_000;
+        double[] best = { 1e9, 1e9, 1e9, 1e9, 1e9, 1e9 };
+        for (int rep = 0; rep < 8; rep++) {
+            long t = System.nanoTime();
+            Object a = null;
+            for (int i = 0; i < N; i++) a = c.map().get(k);
+            best[0] = Math.min(best[0], (double) (System.nanoTime() - t) / N);
+            sink = a;
+            t = System.nanoTime();
+            for (int i = 0; i < N; i++) a = plain.get(k);
+            best[1] = Math.min(best[1], (double) (System.nanoTime() - t) / N);
+            sink = a;
+            // per-"machine tick": field read + loop work baseline
+            int cnt = 0;
+            t = System.nanoTime();
+            for (int i = 0; i < N; i++) if (h.hasWaiting) cnt++;
+            best[2] = Math.min(best[2], (double) (System.nanoTime() - t) / N);
+            t = System.nanoTime();
+            for (int i = 0; i < N; i++) if (!h.waiting.isEmpty()) cnt++;
+            best[3] = Math.min(best[3], (double) (System.nanoTime() - t) / N);
+            t = System.nanoTime();
+            Runnable r;
+            for (int i = 0; i < N; i++) if ((r = h.inbox.poll()) != null) cnt++;
+            best[4] = Math.min(best[4], (double) (System.nanoTime() - t) / N);
+            sink = cnt;
+        }
+        System.out.printf("  V12 volatile+CHM.get %.2f vs HashMap.get %.2f%n", best[0], best[1]);
+        System.out.printf("  V13 volatile boolean %.2f vs ArrayList.isEmpty %.2f%n", best[2], best[3]);
+        System.out.printf("  V15 CLQ.poll empty %.2f%n", best[4]);
+    }
+
+    public static void main(String[] a) {
+        v10();
+        v11();
+        v12to15();
+    }
+}
